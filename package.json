{
	"name": "givetogive",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"db:generate": "dotenv -e .env.local -- drizzle-kit generate",
		"db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
		"db:migrate_prod": "dotenv -e .env.production.hosted -- drizzle-kit migrate",
		"db:push": "dotenv -e .env.local -- drizzle-kit push",
		"db:seed": "dotenv -e .env.local -- node scripts/seed.mjs",
		"db:studio": "dotenv -e .env.local -- drizzle-kit studio --config=drizzle.config.ts",
		"db:studio_prod": "dotenv -e .env.production.hosted -- drizzle-kit studio --config=drizzle.config.ts"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "1.11.3",
		"@emotion/cache": "11.14.0",
		"@emotion/react": "^11.13.3",
		"@emotion/server": "11.11.0",
		"@emotion/styled": "^11.13.0",
		"@mui/icons-material": "^6.1.6",
		"@mui/material": "^6.1.6",
		"@mui/material-nextjs": "9.3.0",
		"@t3-oss/env-nextjs": "0.13.11",
		"@tanstack/react-form": "1.33.5",
		"@tanstack/react-query": "5.102.4",
		"@trpc/client": "11.18.0",
		"@trpc/react-query": "11.18.0",
		"@trpc/server": "11.18.0",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"geist": "1.7.2",
		"next": "16.3.3",
		"next-auth": "5.0.0-beta.32",
		"postgres": "3.4.9",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"server-only": "^0.0.1",
		"superjson": "2.2.6",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"dotenv-cli": "^10.0.0",
		"drizzle-kit": "0.31.10",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.3",
		"postcss": "8.5.26",
		"postcss-load-config": "^4.0.2",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "^0.6.8",
		"tailwindcss": "^3.4.14",
		"typescript": "5.9.3"
	},
	"ct3aMetadata": {
		"initVersion": "7.37.0"
	},
	"packageManager": "npm@10.8.3",
	"overrides": {
		"esbuild": "0.25.12"
	}
}
