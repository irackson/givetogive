{
  "name": "@givetogive/simulation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/community-cli.ts run",
    "legacy:start": "node --experimental-strip-types src/cli.ts run",
    "legacy:preflight": "node --experimental-strip-types src/cli.ts preflight",
    "community": "node --experimental-strip-types src/community-cli.ts",
    "community:supervised": "node --experimental-strip-types src/community-supervisor.ts",
    "community:generate": "node --experimental-strip-types src/community-generate.ts",
    "preflight": "node --experimental-strip-types src/community-cli.ts preflight",
    "benchmark": "node --experimental-strip-types src/benchmark.ts",
    "report": "node --experimental-strip-types src/cli.ts report",
    "sync": "node --experimental-strip-types src/cli.ts sync",
    "sandbox:checkout": "node --experimental-strip-types src/sandbox-cli.ts",
    "sandbox:clock": "node --experimental-strip-types src/clock-cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "setup:models": "pwsh -NoProfile -File scripts/setup-models.ps1",
    "model:start": "pwsh -NoProfile -File scripts/start-model.ps1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "@strands-agents/sdk": "1.19.0",
    "@trpc/server": "11.19.0",
    "openai": "6.49.0",
    "playwright": "1.63.0",
    "superjson": "2.2.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "typescript": "5.9.3"
  }
}
